{
    "name":  "dsh-notify",
    "version":  "0.1.0",
    "description":  "DSH web plugin: system notification when a session\u0027s AI turn finishes, using the DeepSeek black whale icon (Trae-style completion report).",
    "type":  "module",
    "main":  "lib/index.js",
    "exports":  {
                    ".":  "./lib/index.js",
                    "./client":  "./lib/client.js",
                    "./package.json":  "./package.json"
                },
    "dsh":  {
                "client":  {
                               "platform":  "web",
                               "inject":  [
                                              "@deepseek-ai/dsh-client-locale",
                                              "@deepseek-ai/dsh-client-ui-layout",
                                              "@deepseek-ai/dsh-client-ui-settings",
                                              "@deepseek-ai/dsh-client-ui-settings-general"
                                          ]
                           },
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           }
            },
    "files":  [
                  "lib/index.js",
                  "lib/client.js",
                  "cordis.patch.yml"
              ],
    "license":  "MIT",
    "repository":  {
                       "type":  "git",
                       "url":  "git+https://github.com/SailingBoat-ovo/dsh-notify.git"
                   },
    "homepage":  "https://github.com/SailingBoat-ovo/dsh-notify",
    "devDependencies":  {
                            "react":  "^18.3.1",
                            "react-dom":  "^18.3.1"
                        },
    "scripts":  {
                    "test":  "node tests/smoke-test.mjs"
                }
}
